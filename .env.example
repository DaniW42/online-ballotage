# Kopieren nach .env und ausfüllen. .env gehört NICHT ins Repository.

# Langes Zufallspasswort für Postgres
DB_PASSWORD=

# python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Öffentliche URL der Instanz (für Links in E-Mails), ohne abschließenden /
BASE_URL=https://ballotage.online

# SMTP deiner Mail-Infrastruktur (lokal übernimmt Mailpit via docker-compose.override.yml)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kugelung@example.org
SMTP_USE_TLS=true

# Optional
# TIMEZONE=Europe/Berlin
# Verifizierung von Logen: Admin-E-Mail setzen, dann laufen neue Logen im TESTMODUS
# (höchstens 3 Empfänger), bis der Admin sie per Link in der Antrags-Mail freischaltet.
# Leer lassen = keine Verifizierung (alle Logen gelten als verifiziert).
# ADMIN_EMAIL=
# TEST_MODE_MAX_VOTERS=3
# Mindestabstand zwischen zwei E-Mails in Sekunden (global; 0 = aus)
# MAIL_MIN_INTERVAL_SECONDS=1
# IP des Reverse-Proxys (Nginx Proxy Manager), damit Rate-Limits die echte Client-IP sehen
# FORWARDED_ALLOW_IPS=127.0.0.1

# Eigenständiger Betrieb mit Caddy (docker-compose.standalone.yml): Domain für das Zertifikat
# SITE_ADDRESS=ballotage.online

# Impressum und Datenschutzerklärung (Pflichtangaben, sonst erscheint ein Warnhinweis)
LEGAL_NAME=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_EMAIL=
# LEGAL_COUNTRY=Deutschland
# LEGAL_PHONE=
# LEGAL_VAT_ID=
# Hosting-Anbieter, wird in der Datenschutzerklärung genannt
# LEGAL_HOSTING=
# Link zum Quelltext (erscheint unter "Quelltext & Lizenz")
# REPO_URL=https://github.com/...
